<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!--
    genai-prompt (Story 1 Nano honesty eval) requires minSdk 26; the app
    intentionally keeps minSdk 24 for older-device support. All Nano code
    paths are gated on Build.VERSION.SDK_INT >= 26 at runtime; below that
    they return an unavailable result rather than ever executing.
  -->
  <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />
</manifest>
