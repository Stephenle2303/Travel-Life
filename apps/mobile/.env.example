# Non-secret app configuration. Leave unset to keep optional online AI disabled.
EXPO_PUBLIC_TRAVEL_LIFE_SUPABASE_URL=https://fgmcnzxhbrtvjhtafort.supabase.co
EXPO_PUBLIC_TRAVEL_LIFE_SUPABASE_PUBLISHABLE_KEY=
# Optional account entry, independent of history/media sync consent.
EXPO_PUBLIC_TRAVEL_LIFE_ACCOUNT_ENABLED=false
# Automatic catch-up requires explicit completed device attachment and platform tests.
EXPO_PUBLIC_TRAVEL_LIFE_HISTORY_SYNC_ENABLED=false
EXPO_PUBLIC_TRAVEL_LIFE_HISTORY_CONVERGENCE_ENABLED=false
EXPO_PUBLIC_TRAVEL_LIFE_SOURCE_REMOVAL_ENABLED=false
EXPO_PUBLIC_TRAVEL_LIFE_CORRECTIONS_ENABLED=false
# Apply and verify account controls/deletion SQL and cleanup before enabling.
EXPO_PUBLIC_TRAVEL_LIFE_ACCOUNT_CONTROLS_ENABLED=false
# Enable only after private-media server and physical playback acceptance.
EXPO_PUBLIC_TRAVEL_LIFE_PRIVATE_MEDIA_ENABLED=false
EXPO_PUBLIC_TRAVEL_LIFE_AI_PROXY_URL=
# Compatible HTTPS recipient viewer, only after deployment/privacy smoke checks.
EXPO_PUBLIC_TRAVEL_LIFE_SHARE_VIEWER_URL=
# Optional publishable MapTiler vector style. Leave blank to keep the Atlas
# Timeline recovery state; do not add private journey data or a secret here.
EXPO_PUBLIC_ATLAS_MAP_STYLE_URL=
# The publishable key is safe to bundle. Do not place OpenAI keys, service-role
# keys, media, source references, or private evidence in this file.
# Opt-in read-only recognizable reconstruction preview. Development builds only.
EXPO_PUBLIC_TRAVEL_LIFE_RECONSTRUCTION_PREVIEW=false
# Opt-in Local recovery projection for development acceptance.
EXPO_PUBLIC_TRAVEL_LIFE_LOCAL_RECOVERY=false
# Opt-in Local Atlas candidate reveal and review. Development builds only.
EXPO_PUBLIC_TRAVEL_LIFE_RECOGNIZABLE_REVEAL=false
# On-device visual place experiment. Requires a new Android or iOS development build.
EXPO_PUBLIC_TRAVEL_LIFE_VISUAL_PLACE_PREVIEW=false
# Show review-only partial visual clues in the Local development preview.
EXPO_PUBLIC_TRAVEL_LIFE_VISUAL_PARTIAL_PREVIEW=false
# Load a quality-qualified public landmark release in the Android development client.
EXPO_PUBLIC_TRAVEL_LIFE_VISUAL_REGIONAL_PREVIEW=false
EXPO_PUBLIC_TRAVEL_LIFE_VISUAL_REGIONAL_ORIGIN=
EXPO_PUBLIC_TRAVEL_LIFE_VISUAL_REGIONAL_MANIFEST_SHA256=
